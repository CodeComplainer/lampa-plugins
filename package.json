{
    "name": "lampa-plugins",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node tools/build.js",
        "dev": "node tools/build.js --watch",
        "test": "vitest run",
        "lint": "biome check --error-on-warnings src tools",
        "format": "biome check --write src tools",
        "check:compat": "npm run build && npm run check:syntax && npm run check:features",
        "check:syntax": "es-check checkBrowser \"dist/*.js\"",
        "check:features": "es-check checkBrowser \"dist/*.js\" --checkFeatures",
        "index:events": "node tools/index-events.mjs"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.14",
        "browserslist": "^4.29.1",
        "chokidar": "^5.0.0",
        "es-check": "^9.8.1",
        "rolldown": "^1.2.11",
        "ts-morph": "^28.0.0",
        "vitest": "^5.0.2"
    },
    "browserslist": [
        "chrome 79"
    ],
    "engines": {
        "node": ">=22.12"
    }
}
