{
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node",
                        "args": [".claude/hooks/lampa-index-refresh.mjs"],
                        "timeout": 60,
                        "statusMessage": "Реестр событий Lampa"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node",
                        "args": [".claude/hooks/biome-on-save.mjs"],
                        "timeout": 30,
                        "statusMessage": "Biome"
                    }
                ]
            }
        ]
    }
}
